{
  "expo": {
    "name": "Wingdex",
    "slug": "wingdex",
    "scheme": "wingdex",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "11"
    },
    "android": {
      "package": "com.ydzz18.wingdex",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#18352B",
        "foregroundImage": "./assets/favicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/favicon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1B2E26"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wingdex uses the photo you choose to request a bird identification.",
          "cameraPermission": "Wingdex uses your camera to photograph birds for identification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wingdex uses your camera to photograph birds for identification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wingdex saves where you spotted a bird with its observation."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@maplibre/maplibre-react-native/app.plugin.js",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c906a48-ffc7-461c-a9d2-5bfcc87b9a23"
      }
    },
    "owner": "broski12"
  }
}
