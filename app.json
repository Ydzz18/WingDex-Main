{
  "expo": {
    "name": "Wingdex",
    "slug": "wingdex",
    "scheme": "wingdex",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.svg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "7"
    },
    "android": {
      "package": "com.ydzz18.wingdex",
      "versionCode": 7,
      "adaptiveIcon": { 
        "backgroundColor": "#18352B",
        "foregroundImage": "./assets/favicon.svg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wingdex uses the photo you choose to request a bird identification.",
          "cameraPermission": "Wingdex uses your camera to photograph birds for identification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wingdex uses your camera to photograph birds for identification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wingdex saves where you spotted a bird with its observation."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@maplibre/maplibre-react-native/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/favicon.svg",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#18352B"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49fd71eb-2024-4848-81de-13023ce7c545"
      }
    }
  }
}
